# Copy to .env and fill in. Never commit .env.
#
# Every variable the code actually reads is listed here, and only variables the code reads.
# Earlier versions of this file documented WARDEN_* names and three different spellings of the
# PayPal credentials, so a correctly configured deployment could still start the simulator.
#
# Running `make serve` prints a banner listing the rail and the matcher that are genuinely active.
# If it says "simulated" or "lexical", that is what is running - never trust the dashboard alone.

# ── PayPal (sandbox) ──────────────────────────────────────────────────────────────────────────
# developer.paypal.com -> Apps & Credentials -> Sandbox.
# Leave blank to run entirely offline; every receipt then records mode "simulated" so nobody can
# mistake one for a real payment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Which rail to use: auto | sandbox | simulated.
#   auto      -> sandbox when credentials are present, otherwise simulated
#   sandbox   -> fails loudly if credentials are missing (never silently falls back)
#   simulated -> always offline, even if credentials exist
GRACE_PAYPAL_MODE=auto

# ── AI: semantic purpose matching ────────────────────────────────────────────────────────────
# Any OpenAI-compatible /embeddings endpoint. This is the one place a model is genuinely needed:
# "spring campaign design" and "visual assets for our seasonal launch" share almost no tokens.
# Without it, the lexical fallback runs and every judgement records provider "lexical".
GRACE_EMBED_URL=
GRACE_EMBED_MODEL=text-embedding-3-small
GRACE_EMBED_KEY=

# ── AI: rewriting a dispute response (optional) ──────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint. Every sentence of model output must cite an
# evidence id the merchant actually holds; one untraceable sentence discards the whole draft.
GRACE_MODEL_URL=
GRACE_MODEL=gpt-4o-mini
GRACE_MODEL_KEY=

# ── Receipt signing ──────────────────────────────────────────────────────────────────────────
# Change this before showing anyone. Receipts signed with the dev key are not evidence.
GRACE_SIGNING_KEY=
GRACE_SIGNING_KEY_ID=local-dev

# ── API access ───────────────────────────────────────────────────────────────────────────────
# Required for any state-changing route (capture, void, retry, seed, dispute actions).
# If unset, the app refuses to bind those routes to anything but localhost and says so at startup.
GRACE_API_TOKEN=

# ── Storage ──────────────────────────────────────────────────────────────────────────────────
GRACE_DB=grace.db
