# Copy to .env and fill in. Never commit .env.

# ── PayPal ────────────────────────────────────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox.
# Leave these blank to run entirely offline against the simulated rail; every receipt will say
# "simulated" so nobody can mistake one for a real payment.
WARDEN_PAYPAL_MODE=sandbox
WARDEN_PAYPAL_CLIENT_ID=
WARDEN_PAYPAL_CLIENT_SECRET=

# ── Intent judge (optional) ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Without a key the deterministic lexical judge runs instead,
# and receipts record which judge produced the score.
WARDEN_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
WARDEN_LLM_API_KEY=
WARDEN_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# ── Receipt signing ───────────────────────────────────────────────────────────────────────
# Change this before showing anyone. Receipts signed with the dev key are not evidence.
WARDEN_SIGNING_KEY=
WARDEN_SIGNING_KEY_ID=local-dev

# ── Storage ───────────────────────────────────────────────────────────────────────────────
WARDEN_DB=warden.db
